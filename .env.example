# ==========================================
# NAYAK CAPITAL — ENVIRONMENT VARIABLES
# ==========================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://nayakcapital.com

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nayak_capital?retryWrites=true&w=majority

# Security Keys
ADMIN_JWT_SECRET=your_super_secret_64_char_admin_jwt_key_here
CUSTOMER_SESSION_SECRET=your_super_secret_64_char_customer_session_key_here

# Email Settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here
EMAIL_FROM="Nayak Capital Lenders <nayakloanservices@gmail.com>"
ADMIN_NOTIFICATION_EMAIL="nayakloanservices@gmail.com"

# Company Branding
NEXT_PUBLIC_COMPANY_NAME="Nayak Capital"
NEXT_PUBLIC_COMPANY_TAGLINE="TRUSTED LOANS. STRONGER FUTURES."
NEXT_PUBLIC_COMPANY_PHONE="+91 9380810711"
NEXT_PUBLIC_COMPANY_EMAIL="nayakloanservices@gmail.com"
